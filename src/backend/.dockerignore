# OJO: .env NO se excluye a propósito. Dokploy genera backend/.env con las variables del
# panel y el Dockerfile lo copia a la imagen. Por eso:
#   - .env nunca debe subirse a GitHub (.gitignore lo evita);
#   - la imagen contiene secretos: no la publiques en un registro público.
.venv
__pycache__
*.pyc
data
tests
*.db
