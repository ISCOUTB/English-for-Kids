        "summary": "Check Pronunciation",
        "description": "Transcribe el intento del niño y dice si coincide con la palabra.\n\nEl audio se procesa en memoria y NO se guarda (privacidad de menores).",
        "operationId": "check_pronunciation_speech_check_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
