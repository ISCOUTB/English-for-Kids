  "components": {
    "schemas": {
      "AttemptIn": {
        "properties": {
          "palabra": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Palabra",
            "examples": [
              "apple"
            ]
          },
          "idioma": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ],
            "title": "Idioma"
          },
          "acierto": {
            "type": "boolean",
            "title": "Acierto"
          },
          "asistido": {
            "type": "boolean",
            "title": "Asistido",
            "description": "Acierto con ayuda tras varios fallos",
            "default": false
          },
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha",
            "description": "Momento real del intento, si estuvo en cola sin conexión (opcional)"
          }
        },
        "type": "object",
        "required": [
          "palabra",
          "idioma",
          "acierto"
        ],
        "title": "AttemptIn"
      },
      "AttemptsIn": {
        "properties": {
          "nino_id": {
            "type": "integer",
            "title": "Nino Id"
          },
          "intentos": {
            "items": {
              "$ref": "#/components/schemas/AttemptIn"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Intentos"
          }
        },
        "type": "object",
        "required": [
          "nino_id",
          "intentos"
        ],
        "title": "AttemptsIn"
      },
      "AttemptsOut": {
        "properties": {
          "guardados": {
            "type": "integer",
            "title": "Guardados"
          }
        },
        "type": "object",
        "required": [
          "guardados"
        ],
        "title": "AttemptsOut"
      },
      "Body_check_pronunciation_speech_check_post": {
        "properties": {
          "nino_id": {
            "type": "integer",
            "title": "Nino Id"
          },
          "palabra": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Palabra",
            "description": "Palabra que el niño intentó decir"
          },
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio",
            "description": "Grabación del intento"
          }
        },
        "type": "object",
        "required": [
          "nino_id",
          "palabra",
          "audio"
        ],
        "title": "Body_check_pronunciation_speech_check_post"
      },
      "ChildIn": {
        "properties": {
          "apodo": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Apodo",
            "examples": [
              "Lulú"
            ]
          },
          "rango_edad": {
            "type": "string",
            "enum": [
              "3-4",
              "5-6"
            ],
            "title": "Rango Edad"
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar"
          }
        },
        "type": "object",
        "required": [
          "apodo",
          "rango_edad"
        ],
        "title": "ChildIn"
      },
      "ChildOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "apodo": {
            "type": "string",
            "title": "Apodo"
          },
          "rango_edad": {
            "type": "string",
            "title": "Rango Edad"
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar"
          }
        },
        "type": "object",
        "required": [
          "id",
          "apodo",
          "rango_edad",
          "avatar"
        ],
        "title": "ChildOut"
      },
      "ConsentIn": {
        "properties": {
          "tipo": {
            "type": "string",
            "const": "voz",
            "title": "Tipo"
          },
          "aceptado": {
            "type": "boolean",
            "title": "Aceptado"
          }
        },
        "type": "object",
        "required": [
          "tipo",
          "aceptado"
        ],
        "title": "ConsentIn"
      },
      "ConsentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "aceptado": {
            "type": "boolean",
            "title": "Aceptado"
          },
          "fecha": {
            "type": "string",
            "format": "date-time",
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tipo",
          "aceptado",
          "fecha"
        ],
        "title": "ConsentOut"
      },
      "DayStats": {
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          },
          "intentos": {
            "type": "integer",
