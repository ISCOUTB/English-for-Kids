            }
          },
          {
            "name": "tz_offset_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 840,
              "minimum": -840,
              "description": "Diferencia de la zona horaria del tutor con UTC, en minutos (Colombia: -300)",
              "default": 0,
              "title": "Tz Offset Min"
            },
            "description": "Diferencia de la zona horaria del tutor con UTC, en minutos (Colombia: -300)"
