    "/speech/judge": {
      "post": {
        "tags": [
          "speech"
        ],
        "summary": "Judge Pronunciation",
        "description": "Segunda opinión con IA, para cuando las reglas locales de la app no aceptaron el intento.\n\nRecibe SOLO el texto que reconoció el teléfono (nunca audio). Sirve para inglés y español\n(`idioma`). Primero repite la comprobación local, que es gratis e instantánea; la IA solo\nse consulta si esa comprobación falla. Los niños de 3-4 años reciben más indulgencia.",
        "operationId": "judge_pronunciation_speech_judge_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JudgeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JudgeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
