# Copia este archivo como backend/.env para desarrollo local y completa los valores.
# NUNCA subas el .env real al repositorio. En el panel de la universidad, estas mismas
# variables se configuran en la sección de variables de entorno del proyecto.

# --- Base de datos (PostgreSQL del panel) ---------------------------------
# Valores de "Internal Credentials" del panel. La contraseña la copias tú.
DB_HOST=data-englishforkids-pip1do
DB_PORT=5432
DB_NAME=data-englishforkids
DB_USER=postgres
DB_PASSWORD=

# Alternativa: pegar la "Internal Connection URL" completa (tiene prioridad sobre las DB_*).
# DATABASE_URL=
# Para probar en tu computador sin PostgreSQL:
# DATABASE_URL=sqlite:///./dev.db

# --- Seguridad -------------------------------------------------------------
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Orígenes web permitidos (solo si pruebas una versión web), separados por coma. Vacío = ninguno.
CORS_ORIGINS=

# --- Proveedores externos (las llaves las pones tú) -----------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# --- Límites (opcionales) ---------------------------------------------------
# DAILY_STORY_LIMIT=20
# MAX_AUDIO_BYTES=5000000
# AUDIO_DIR=data/audio
